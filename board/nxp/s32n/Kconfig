if NXP_S32N

config NXP_S32N_BOARD_COMMON
	bool
	default n
	imply CMD_CACHE
	imply CMD_CPU
	imply CMD_DM
	imply CMD_MD5SUM
	imply MD5SUM_VERIFY
	imply USE_BOOTARGS

config BOARD_DRAM_BASE
	hex
	default 0x80000000

config BOARD_DRAM_SIZE
	hex
	default 0x80000000

config DTB_ADDR
	hex "Default OS device tree blob address"
	default 0x93000000

config RAMDISK_ADDR
	hex "Default ramdisk address to be used by the OS"
	default 0x94000000

config MEM_BOOT
	bool "Boot kernel images from DDR"
	default n
	help
	  Enable this option if the kernel images are already loaded in memory
	  (eg. DDR), which is a common scenario in Simulator/Emulator case.

endif
