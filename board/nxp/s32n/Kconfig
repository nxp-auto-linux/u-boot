if NXP_S32N

config NXP_S32N_BOARD_COMMON
	bool
	default n
	imply CMD_CACHE
	imply CMD_CPU
	imply CMD_DM
	imply CMD_MD5SUM
	imply MD5SUM_VERIFY
	imply USE_BOOTARGS

config SYS_LOAD_RAM_OFFSET
	hex "Default OS image offset in RAM."
	default 0x10000000

config DTB_RAM_OFFSET
	hex "Default OS device tree blob offset in RAM."
	default 0x13000000

config RAMDISK_RAM_OFFSET
	hex "Default ramdisk offset in RAM to be used by the OS."
	default 0x14000000

config MEM_BOOT
	bool "Boot kernel images from RAM."
	default n
	help
	  Enable this option if the kernel images are already loaded in memory
	  (eg. DDR), which is a common scenario in Simulator/Emulator case.

endif
