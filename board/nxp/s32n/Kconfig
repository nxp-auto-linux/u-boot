if NXP_S32N

config NXP_S32N_BOARD_COMMON
	bool
	default n
	imply CMD_CACHE
	imply CMD_CPU
	imply CMD_DM
	imply CMD_MD5SUM
	imply MD5SUM_VERIFY
	imply USE_BOOTARGS

config SYS_LOAD_RAM_OFFSET
	hex "Default OS image offset in RAM."
	default 0x13200000

config DTB_RAM_OFFSET
	hex "Default OS device tree blob offset in RAM."
	default 0x13100000

config RAMDISK_RAM_OFFSET
	hex "Default ramdisk offset in RAM to be used by the OS."
	default 0x16000000

endif
