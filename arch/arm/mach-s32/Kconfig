config DEFAULT_DEVICE_TREE
	default "s32"

config SYS_LOAD_ADDR
	default 0 if ARCH_S32N79
	default 0x80000000

config SYS_MALLOC_F_LEN
	default 0x50000

config ENV_OFFSET
	default 0x280000 if !ENV_IS_IN_FAT

config XEN_SUPPORT
	bool "Enable Xen Hypervisor boot support"
	default n
	help
	  Set U-Boot environment in order for U-Boot to boot Xen Hypervisor
	  based on a boot script generated by Imagebuilder. The script loads
	  all the necessary binaries (kernel image, Xen image, DTB) from
	  storage and sets the DT '/chosen' node accordingly.

