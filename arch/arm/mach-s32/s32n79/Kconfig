if ARCH_S32N79

choice
	prompt "S32N79 board select"
	default TARGET_S32N79SIM

config TARGET_S32N79SIM
	bool "Support S32N79SIM simulator"
	help
	  This board is based on the S32N79 simulator.
	select SPI_FLASH_SPANSION
	select SPI_FLASH_S28HX_T

endchoice

config ENV_IS_IN_FAT
	default y if !MEM_BOOT

config ENV_FAT_INTERFACE
	default "mmc" if SD_BOOT
	default "scsi"

config ENV_FAT_DEVICE_AND_PART
	default "0:3"

config ENV_SIZE
	default 0x2000

if DEBUG_UART

# Use UART0 by default
config DEBUG_UART_BASE
	default 0x4A030000

endif

source "board/nxp/s32n79sim/Kconfig"

endif
