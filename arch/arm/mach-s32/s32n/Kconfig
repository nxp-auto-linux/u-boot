if NXP_S32N

config LMB_MAX_REGIONS
	default 16

config S32N_CMD_DDR_INIT
	bool "ddr_init - initialize a DDR region via the NXP DDR SCMI protocol"
	depends on NXP_DDR_SCMI
	help
	  Adds the 'ddr_init' command, which brings up a high DDR region
	  on NXP S32N SoCs by asking the FSS firmware to initialize it. This
	  is useful for initializing DDR that is not initialized by FSS itself
	  or via requests from other components earlier in the boot flow.

source "arch/arm/mach-s32/s32n79/Kconfig"
source "board/nxp/s32n/Kconfig"

endif
